# ─────────────────────────────────────────────
# DevLab — Configuration par défaut
# Ce fichier EST commité. Ne jamais y mettre de secrets.
# Surcharger via config/local.env (gitignored)
# ─────────────────────────────────────────────

# ── Identité système ──────────────────────────
# DEVLAB_ROOT est auto-détecté depuis l'emplacement du script (lib/core.sh)
# Décommentez pour forcer un chemin fixe (ex: si cloné dans /devlab) :
# DEVLAB_ROOT="/devlab"
DEVLAB_USER="root"
DEVLAB_GROUP="devlab"

# ── Comportement général ──────────────────────
LOG_LEVEL="INFO"              # DEBUG | INFO | WARN | ERROR
DEVLAB_AUTO_CONFIRM="false"   # true = skip confirmation prompts
DEVLAB_DRY_RUN="false"        # true = simulate without executing

# ── SSH ───────────────────────────────────────
SSH_PORT="22"
SSH_PERMIT_ROOT=""          # "no" pour désactiver (ATTENTION : clé SSH requise au préalable)
SSH_PASSWORD_AUTH=""        # "no" pour désactiver (ATTENTION : clé SSH requise au préalable)
SSH_MAX_AUTH_TRIES="3"

# ── Firewall (UFW) ────────────────────────────
UFW_ENABLED="true"
UFW_ALLOW_PORTS="22 80 443 8080 8443 3000 4000 5000"

# ── Versions épinglées ────────────────────────
# Laisser vide pour utiliser la dernière LTS/stable
NODE_VERSION="lts"
PYTHON_VERSION="3.12"
PHP_VERSION="8.3"
GO_VERSION=""           # vide = dernière stable
RUST_VERSION="stable"

# ── Bases de données ──────────────────────────
POSTGRES_VERSION="16"
POSTGRES_PORT="5432"
MARIADB_VERSION="10.11"
MARIADB_PORT="3306"
REDIS_PORT="6379"
REDIS_BIND="127.0.0.1"

# ── Nginx ─────────────────────────────────────
NGINX_HTTP_PORT="80"
NGINX_HTTPS_PORT="443"

# ── Code Server ───────────────────────────────
CODE_SERVER_PORT="8080"
CODE_SERVER_AUTH="password"

# ── GamadCode Web UI ──────────────────────────
GAMADCODE_UI_PORT="3000"
GAMADCODE_DOMAIN=""         # domaine pour VS Code (code-server) — ex: code.gamad.net
GAMADCODE_UI_DOMAIN=""      # domaine pour le dashboard GamadCode — ex: app.gamad.net
GAMADCODE_PROJECT_NAME="GamadCode"
ADMIN_GITHUB_LOGIN=""       # GitHub login de l'admin (vide = accès ouvert en local)
GITHUB_CLIENT_ID=""         # À mettre dans config/secrets.env
GITHUB_CALLBACK_URL=""      # ex: https://app.gamad.net/auth/github/callback

# ── GamadCode SaaS — Workspaces utilisateurs ──
WORKSPACE_BASE="/opt/gamadcode/users"    # Dossier des workspaces Docker par user
CODE_SERVER_IMAGE="codercom/code-server:latest"

# ── SMTP (email magic-link) ───────────────────
# À configurer dans config/secrets.env pour la production
# Sans SMTP : les liens de connexion s'affichent dans les logs (mode dev)
SMTP_HOST=""        # ex: smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false" # true pour le port 465
SMTP_FROM="GamadCode <noreply@gamadcode.dev>"
# SMTP_USER et SMTP_PASS → dans secrets.env

# ── PostgreSQL SaaS ───────────────────────────
POSTGRES_DB="gamadcode"
POSTGRES_USER="gamadcode"
# POSTGRES_PASSWORD → dans secrets.env
# POSTGRES_HOST et POSTGRES_PORT utilisent les valeurs ci-dessous (Bases de données)

# ── Docker ────────────────────────────────────
DOCKER_DATA_ROOT="/var/lib/docker"

# ── GitHub / Git ──────────────────────────────
# À surcharger dans config/local.env (ne pas mettre de secrets ici)
GIT_USER_NAME=""        # Votre nom pour les commits git
GIT_USER_EMAIL=""       # Votre email pour les commits git
GIT_DEFAULT_BRANCH="main"
GITHUB_USERNAME=""      # Votre username GitHub (pour gh CLI)

# ── Chemins internes ──────────────────────────
DEVLAB_WORKSPACE="${DEVLAB_ROOT}/workspace"
DEVLAB_REPOS="${DEVLAB_ROOT}/repositories"
DEVLAB_LOGS="${DEVLAB_ROOT}/logs"
DEVLAB_BACKUPS="${DEVLAB_ROOT}/backups"
DEVLAB_STATE="${DEVLAB_ROOT}/state"
