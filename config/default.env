# ─────────────────────────────────────────────
# DevLab — Configuration par défaut
# Ce fichier EST commité. Ne jamais y mettre de secrets.
# Surcharger via config/local.env (gitignored)
# ─────────────────────────────────────────────

# ── Identité système ──────────────────────────
# DEVLAB_ROOT est auto-détecté depuis l'emplacement du script (lib/core.sh)
# Décommentez pour forcer un chemin fixe (ex: si cloné dans /devlab) :
# DEVLAB_ROOT="/devlab"
DEVLAB_USER="devuser"
DEVLAB_GROUP="devlab"

# ── Comportement général ──────────────────────
LOG_LEVEL="INFO"              # DEBUG | INFO | WARN | ERROR
DEVLAB_AUTO_CONFIRM="false"   # true = skip confirmation prompts
DEVLAB_DRY_RUN="false"        # true = simulate without executing

# ── SSH ───────────────────────────────────────
SSH_PORT="22"
SSH_PERMIT_ROOT="no"
SSH_PASSWORD_AUTH="no"
SSH_MAX_AUTH_TRIES="3"

# ── Firewall (UFW) ────────────────────────────
UFW_ENABLED="true"
UFW_ALLOW_PORTS="22 80 443 8080 8443 3000 4000 5000"

# ── Versions épinglées ────────────────────────
# Laisser vide pour utiliser la dernière LTS/stable
NODE_VERSION="lts"
PYTHON_VERSION="3.12"
PHP_VERSION="8.3"
GO_VERSION=""           # vide = dernière stable
RUST_VERSION="stable"

# ── Bases de données ──────────────────────────
POSTGRES_VERSION="16"
POSTGRES_PORT="5432"
MARIADB_VERSION="10.11"
MARIADB_PORT="3306"
REDIS_PORT="6379"
REDIS_BIND="127.0.0.1"

# ── Nginx ─────────────────────────────────────
NGINX_HTTP_PORT="80"
NGINX_HTTPS_PORT="443"

# ── Code Server ───────────────────────────────
CODE_SERVER_PORT="8080"
CODE_SERVER_AUTH="password"

# ── Docker ────────────────────────────────────
DOCKER_DATA_ROOT="/var/lib/docker"

# ── Chemins internes ──────────────────────────
DEVLAB_WORKSPACE="${DEVLAB_ROOT}/workspace"
DEVLAB_REPOS="${DEVLAB_ROOT}/repositories"
DEVLAB_LOGS="${DEVLAB_ROOT}/logs"
DEVLAB_BACKUPS="${DEVLAB_ROOT}/backups"
DEVLAB_STATE="${DEVLAB_ROOT}/state"
